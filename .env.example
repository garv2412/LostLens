# LostLens Environment Configuration

# Mode: 'demo' (default, no AWS credentials required) or 'live'
NEXT_PUBLIC_APP_MODE=demo

# AWS Configuration (Required only when NEXT_PUBLIC_APP_MODE=live)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon S3
AWS_S3_BUCKET_NAME=lostlens-item-photos-dev
AWS_S3_PRESIGNED_EXPIRATION_SECONDS=900

# Amazon DynamoDB
DYNAMODB_TABLE_LISTINGS=LostLens_Listings
DYNAMODB_TABLE_MATCHES=LostLens_Matches
DYNAMODB_TABLE_CLAIMS=LostLens_Claims
DYNAMODB_TABLE_NOTIFICATIONS=LostLens_Notifications

# Amazon Rekognition
REKOGNITION_MIN_CONFIDENCE=75

# Amazon SNS
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:lostlens-match-alerts
AWS_SNS_ENABLED=false
